<Window x:Class="WpfSolarSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfSolarSystem"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Canvas x:Name="solarSystemCanvas" Background="#A7C7E7">
        <Ellipse x:Name="sun" Height="150" Width="150"
                 Canvas.Top="160" Canvas.Left="310" Fill="Yellow"></Ellipse>
    </Canvas>
</Window>
